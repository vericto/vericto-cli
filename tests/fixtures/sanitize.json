{
  "source": "vericto/vericto-cli tests/fixtures/sanitize.json, release 1.8.2: the test vectors of src/sanitize.rs. Every entry is run by src/sanitize.rs's tests, and vericto-python runs this same file (tests/fixtures/sanitize/vericto-cli-1.8.2.json) against its port. Change both together with the sanitizer. 'test' names a group, which is also a #[test] in src/sanitize.rs.",
  "vectors": [
    {"test": "strips_string_literals_postgres_numbered", "dialect": "postgres", "sql": "SELECT * FROM users WHERE email = 'a@b.com'", "expected": "SELECT * FROM users WHERE email = $1"},
    {"test": "sqlite_uses_question_mark_and_keeps_its_identifiers", "dialect": "sqlite", "sql": "SELECT [it's], `a` FROM t WHERE x = $id AND y = 'O''Brien' AND z = 7", "expected": "SELECT [it's], `a` FROM t WHERE x = $id AND y = ? AND z = ?"},
    {"test": "sqlite_uses_question_mark_and_keeps_its_identifiers", "dialect": "sqlite", "sql": "WHERE p = 'C:\\' AND q = 'x'", "expected": "WHERE p = ? AND q = ?"},
    {"test": "existing_bind_parameters_are_kept", "dialect": "postgres", "sql": "SELECT a FROM t WHERE id = $1 AND name = $2", "expected": "SELECT a FROM t WHERE id = $1 AND name = $2"},
    {"test": "existing_bind_parameters_are_kept", "dialect": "sqlite", "sql": "SELECT a FROM t WHERE id = ?1 AND b = ?2 AND n = 5", "expected": "SELECT a FROM t WHERE id = ?1 AND b = ?2 AND n = ?"},
    {"test": "snowflake_uses_question_mark", "dialect": "snowflake", "sql": "SELECT $1 FROM @stage WHERE a = 'x'", "expected": "SELECT $1 FROM @stage WHERE a = ?"},
    {"test": "mysql_uses_question_mark", "dialect": "mysql", "sql": "SELECT * FROM users WHERE email = 'a@b.com'", "expected": "SELECT * FROM users WHERE email = ?"},
    {"test": "numbered_placeholders_increment", "dialect": "postgres", "sql": "WHERE a = 'x' AND b = 'y' AND c = 5", "expected": "WHERE a = $1 AND b = $2 AND c = $3"},
    {"test": "handles_escaped_quotes", "dialect": "postgres", "sql": "WHERE name = 'O''Brien'", "expected": "WHERE name = $1"},
    {"test": "strips_numbers_but_not_identifiers", "dialect": "postgres", "sql": "WHERE id = 42 AND col2 = 7", "expected": "WHERE id = $1 AND col2 = $2"},
    {"test": "dollar_quoted_body_is_emptied", "dialect": "postgres", "sql": "DO $$ BEGIN PERFORM 'secret'; END $$", "expected": "DO $$$$"},
    {"test": "dollar_quoted_body_is_emptied", "dialect": "postgres", "sql": "do $$ x $$", "expected": "do $$$$"},
    {"test": "dollar_quoted_body_is_emptied", "dialect": "postgres", "sql": "CREATE FUNCTION f() RETURNS text AS $fn$ SELECT 'secret' $fn$ LANGUAGE sql", "expected": "CREATE FUNCTION f() RETURNS text AS $$$$ LANGUAGE sql"},
    {"test": "dollar_quoted_body_is_emptied", "dialect": "snowflake", "sql": "CREATE PROCEDURE p() RETURNS STRING LANGUAGE JAVASCRIPT AS $$ return \"secret\"; $$", "expected": "CREATE PROCEDURE p() RETURNS STRING LANGUAGE JAVASCRIPT AS $$$$"},
    {"test": "leaves_quoted_identifiers_intact", "dialect": "postgres", "sql": "SELECT \"user's col\" FROM t", "expected": "SELECT \"user's col\" FROM t"},
    {"test": "mysql_backslash_escaped_quote_does_not_leak", "dialect": "mysql", "sql": "WHERE note = 'it\\'s secret-token' AND id = 1", "expected": "WHERE note = ? AND id = ?"},
    {"test": "mysql_escaped_backslash_before_closing_quote", "dialect": "mysql", "sql": "WHERE p = 'C:\\\\' AND q = 'x'", "expected": "WHERE p = ? AND q = ?"},
