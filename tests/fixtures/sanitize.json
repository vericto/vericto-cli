    {"test": "snowflake_backslash_escape_does_not_leak", "dialect": "snowflake", "sql": "WHERE note = 'it\\'s secret-token' AND id = 1", "expected": "WHERE note = ? AND id = ?"},
    {"test": "snowflake_backslash_escape_does_not_leak", "dialect": "snowflake", "sql": "WHERE p = 'C:\\\\' AND q = 'x'", "expected": "WHERE p = ? AND q = ?"},
